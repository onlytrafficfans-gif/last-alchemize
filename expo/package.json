{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "expo start",
    "start-web": "expo start --web",
    "start-web-dev": "DEBUG=expo* expo start --web",
    "lint": "expo lint",
    "test": "bun test lib/__tests__",
    "typecheck": "tsc --noEmit",
    "validate:handoff": "node scripts/validate-handoff.js",
    "validate:routes": "node scripts/route-manifest-check.js",
    "validate:health": "node scripts/repo-health-check.js",
    "validate:production": "node scripts/production-preflight.js",
    "validate:final": "node scripts/final-validation.js",
    "ci:local": "bun run validate:final && bunx expo-doctor && bun run lint",
    "ci:audit": "bun audit --audit-level=moderate",
    "backend:dev": "tsx backend/server.ts"
  },
